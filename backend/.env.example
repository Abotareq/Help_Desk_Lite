# Server
PORT=3000
NODE_ENV=development

# Database
#
# Local development uses MONGODB_URI. Hosted deployments set DATABASE_URL
# instead, which wins when both are present — same value, different name,
# because that is what the platform's dashboard calls it.
#
# Give the URI an explicit database name. A connection string ending in a bare
# "/" silently lands everything in a database called "test", which looks like
# your data has vanished the first time you go looking for it.
#
#   DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/helpdesk_lite?retryWrites=true&w=majority
#
# Never commit a real connection string. This file is the shape, not the secret.
MONGODB_URI=mongodb://127.0.0.1:27017/helpdesk_lite

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Sign-in throttling: failed attempts per IP, per window.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Reverse proxies in front of this service. Rate limiting keys on the client IP,
# and behind a proxy every request looks like it came from the proxy unless
# Express is told how far back to read X-Forwarded-For. Leave at 0 unless you
# actually run behind one — trusting a header nobody sets lets a caller spoof
# past the limit.
TRUST_PROXY_HOPS=0

# Bootstrap manager (used by `npm run seed`)
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=ChangeMe123!
SEED_MANAGER_NAME=Bootstrap Manager
