{
  "name": "helpdesk-lite",
  "version": "1.0.0",
  "private": true,
  "description": "HelpDesk Lite — internal support ticketing workspace (API + web client)",
  "license": "ISC",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace backend",
    "build:web": "npm run build --workspace frontend",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspace backend",
    "lint": "npm run lint --workspaces --if-present",
    "seed": "npm run seed --workspace backend"
  },
  "engines": {
    "node": ">=20"
  }
}
